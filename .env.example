# Core server configuration
# Local/test compatibility connection. It is forbidden in pilot web/release
# environments after 3-B3C4 and is never a substitute for an actor identity.
DATABASE_URL=
# Customer-scoped connection. Required in pilot and authenticates as a LOGIN
# member of the non-owner bsrc_runtime role.
DATABASE_RUNTIME_URL=
# Verified Stripe/Paddle lifecycle connection. Required in pilot and authenticates
# as a LOGIN member of the non-owner, non-BYPASSRLS bsrc_system role.
DATABASE_SYSTEM_URL=
# Procedure-only platform owner/admin connection. Required in pilot.
DATABASE_OWNER_URL=
# DDL/migration/catalog connection. Required in pilot/production tooling only;
# it must never be present in the deployed web runtime.
MIGRATION_DATABASE_URL=
# off | pilot | enforced. `enforced` is reserved and rejected until 3-B4.
DATABASE_RLS_MODE=off
# Production execution masters are fail-closed and require an exact explicit
# false for controlled test cutovers. They may be enabled only by a separately
# authorized live-provider release.
BILLING_EXECUTION_ENABLED=false
AI_EXECUTION_ENABLED=false
DEMO_CLEANUP_EXECUTION_ENABLED=false
PRIVACY_RETENTION_EXECUTION_ENABLED=false
PRIVACY_DELETION_REQUESTS_ENABLED=false
PRIVACY_DELETION_EXECUTION_ENABLED=false
# Provider cleanup is a separate, fail-closed B4 worker boundary. Keep every
# control false until provider-specific staging acceptance is recorded.
PRIVACY_PROVIDER_CLEANUP_WORKER_ENABLED=false
PRIVACY_PROVIDER_RECONCILIATION_ENABLED=false
PRIVACY_PROVIDER_CLEANUP_ADAPTER=fake_test
PRIVACY_PROVIDER_VERCEL_BLOB_ENABLED=false
PRIVACY_PROVIDER_VERCEL_BLOB_STORE_ID=
PRIVACY_PROVIDER_VERCEL_DOMAINS_ENABLED=false
PRIVACY_PROVIDER_VERCEL_DOMAINS_PROJECT_ID=
PRIVACY_PROVIDER_VERCEL_DOMAINS_TEAM_ID=
PRIVACY_PROVIDER_STRIPE_ENABLED=false
PRIVACY_PROVIDER_PADDLE_ENABLED=false
PRIVACY_PROVIDER_RESEND_ENABLED=false
PRIVACY_PROVIDER_OPENAI_ENABLED=false
PRIVACY_PROVIDER_GOOGLE_ENABLED=false
PRIVACY_PROVIDER_REDI_CONTROL_ENABLED=false
PRIVACY_EXPORT_ENABLED=false
PRIVACY_EXPORT_ARTIFACT_STORE=memory_test
PRIVACY_EXPORT_ENVIRONMENT_ID=local
PRIVACY_EXPORT_ENCRYPTION_KEY_VERSION=v1
PRIVACY_EXPORT_ENCRYPTION_KEYS=
PRIVACY_EXPORT_BLOB_STORE_ID=
PRIVACY_EXPORT_BLOB_READ_WRITE_TOKEN=
DATABASE_MIGRATOR_ROLE=bsrc_migrator
DATABASE_RUNTIME_ROLE=bsrc_runtime
DATABASE_SYSTEM_ROLE=bsrc_system
DATABASE_OWNER_ROLE=bsrc_owner_ops
DATABASE_RUNTIME_EXECUTOR_ROLE=bsrc_runtime_executor
DATABASE_BOOTSTRAP_EXECUTOR_ROLE=bsrc_bootstrap_executor
DATABASE_OWNER_EXECUTOR_ROLE=bsrc_owner_executor
DATABASE_SYSTEM_EXECUTOR_ROLE=bsrc_system_executor
# Local/disposable admin provisioning only. Provider-created roles are preferred.
DATABASE_CREATE_ROLES=false
# Conservative serverless defaults. Raise only after measuring provider limits.
DATABASE_POOL_MAX=3
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_QUERY_TIMEOUT_MS=15000
# Plan-level quota scaling and fair-use warning threshold.
TENANT_QUOTA_MULTIPLIER_STARTER=1
TENANT_QUOTA_MULTIPLIER_PROFESSIONAL=1
TENANT_QUOTA_MULTIPLIER_PREMIUM=1
TENANT_QUOTA_WARNING_PERCENT=80
OWNER_MFA_ENCRYPTION_KEY=replace-with-base64url-32-byte-key
# Local invitation acceptance automation only. Never enable in production.
OWNER_INVITATION_DEV_LINKS=false
PREVIEW_TOKEN_SECRET=replace-with-a-separate-long-random-secret
PUBLIC_APP_URL=http://localhost:3000
# Optional exact host for the platform-owner workspace. It serves only /owner,
# /api/owner and /api/health; other routes fail closed or return to the public host.
CONTROL_PANEL_HOST=
# Optional exact additional platform/preview hosts, comma-separated. Never use wildcards.
PLATFORM_ADDITIONAL_HOSTS=
CRON_SECRET=replace-with-a-separate-long-random-secret
# Vercel Cron-compatible privacy orchestration. The master and every worker or
# provider execution control default off. One run leases at most 25 deletion
# progression steps and one 25-item export cleanup batch.
PRIVACY_SCHEDULER_ENABLED=false
PRIVACY_SCHEDULER_NOOP=false
PRIVACY_SCHEDULER_MAX_DELETION_STEPS=5
PRIVACY_SCHEDULER_MAX_DURATION_MS=50000
# Provider-neutral server error delivery. The endpoint must be HTTPS, contain no
# URL credentials/query/fragment and have an exact hostname in the allowlist.
CENTRAL_ERROR_REPORTING_ENABLED=false
CENTRAL_ERROR_REPORTING_ENDPOINT=
CENTRAL_ERROR_REPORTING_ALLOWED_HOSTS=
CENTRAL_ERROR_REPORTING_SECRET=
CENTRAL_ERROR_REPORTING_TIMEOUT_MS=3000
# Aggregate database/webhook/privacy signals through the system-only snapshot.
MONITORING_ALERTS_ENABLED=false
MONITORING_WEBHOOK_WINDOW_MINUTES=15
MONITORING_STALE_LEASE_MINUTES=5
MONITORING_DATABASE_CONNECTION_WARNING_PERCENT=80
# Staging acceptance only; the authenticated probe is rejected in Production.
MONITORING_SYNTHETIC_PROBE_ENABLED=false
# Preview-only external scheduler/dead-man boundary. Never enable or reuse this
# query capability in Vercel Production; rotate it when a staging monitor retires.
MONITORING_STAGING_SCHEDULER_ENABLED=false
MONITORING_STAGING_SCHEDULER_SECRET=
MONITORING_HEARTBEAT_MAX_AGE_SECONDS=900
MONITORING_HEARTBEAT_STALE_RUN_SECONDS=180

# Recovery-operator only. Never copy these credentials into the web runtime.
RECOVERY_BACKUP_DIRECTORY=
RECOVERY_BACKUP_MANIFEST=
RECOVERY_BACKUP_MAX_AGE_HOURS=24
RECOVERY_OBJECT_STORE_ALLOWED_HOSTS=
RECOVERY_OBJECT_PREFIX=daily/postgres
AWS_ENDPOINT_URL=
AWS_DEFAULT_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Deployment profile: core | finder | billing | full-production
PLATFORM_PROFILE=core
# local | staging | production; deployment safety and provider adapters use it
# independently of NODE_ENV.
RELEASE_TARGET=local
# Maximum uncached Google Places provider calls per owner IP per day.
FINDER_PROVIDER_CALL_LIMIT=30

# Optional provider-neutral AI assistant. Secrets stay server-side.
AI_PROVIDER=disabled
OPENAI_API_KEY=
# Optional OpenAI-compatible endpoint override for buyer-managed infrastructure.
OPENAI_BASE_URL=https://api.openai.com/v1
AI_OWNER_ENABLED=false
AI_CLIENT_ENABLED=false
# Explicit opt-in because this performs server-side reads of public business websites.
AI_WEBSITE_FETCH_ENABLED=false
AI_OWNER_MODEL=gpt-5.6-sol
AI_CLIENT_MODEL=gpt-5.6-luna
AI_CLIENT_DAILY_LIMIT=10
AI_MAX_WEBSITE_CHARACTERS=24000
AI_MAX_WEBSITE_PAGES=6

# Legacy/secondary provider switches. Billing and AI masters above still take
# precedence and remain the authoritative execution boundary.
PADDLE_ENABLED=false
REDI_IMPORT_ENABLED=false

# Short-lived, deployment-host-bound cutover verifier. Set only for the guarded
# acceptance window, use a SHA-256 digest (never the bearer), then remove it.
CUTOVER_VERIFICATION_TOKEN_SHA256=
CUTOVER_VERIFICATION_NOT_BEFORE=
CUTOVER_VERIFICATION_EXPIRES_AT=

# Optional Redi Control social-media workspace integration. All values are server-only.
REDI_CONTROL_ENABLED=false
REDI_CONTROL_API_URL=
REDI_CONTROL_APP_URL=
REDI_CONTROL_INTEGRATION_ID=
REDI_CONTROL_INTEGRATION_SECRET=
REDI_CONTROL_REQUEST_TIMEOUT_MS=8000
# Optional REDI CONTROL -> Information/News inbound editorial API.
# Keep disabled until per-site permissions are explicitly approved by the owner.
REDI_CONTROL_INBOUND_ENABLED=false
REDI_CONTROL_INBOUND_SECRET=

# Business Finder (Places API New + Geocoding API)
GOOGLE_MAPS_API_KEY=

# Buyer white-label settings. These values are visible in the browser.
NEXT_PUBLIC_BRAND_PROFILE_KEY=businesssite-rc
NEXT_PUBLIC_BRAND_ASSET_VERSION=2026-08-24
NEXT_PUBLIC_PLATFORM_NAME=BusinessSite RC
NEXT_PUBLIC_PLATFORM_SHORT_NAME=BusinessSite
NEXT_PUBLIC_PLATFORM_TAGLINE=Website RemoteControl
NEXT_PUBLIC_PLATFORM_DESCRIPTION=Professional websites for local businesses.
NEXT_PUBLIC_PLATFORM_LOGO_URL=/images/brand/businesssite-logo-horizontal-v3.png
NEXT_PUBLIC_PLATFORM_LOGO_MARK_URL=/images/brand/businesssite-logo.png
NEXT_PUBLIC_PLATFORM_FAVICON_URL=/images/brand/businesssite-logo.png
NEXT_PUBLIC_PWA_ICON_URL=/images/brand/businesssite-logo.png
NEXT_PUBLIC_PWA_MASKABLE_ICON_URL=/images/brand/businesssite-logo.png
NEXT_PUBLIC_APPLE_TOUCH_ICON_URL=/images/brand/businesssite-logo.png
NEXT_PUBLIC_PLATFORM_SOCIAL_IMAGE_URL=/images/brand/businesssite-logo-horizontal-v3.png
NEXT_PUBLIC_PLATFORM_MARK=BR
NEXT_PUBLIC_PLATFORM_LOCALE=de
# Customer lifecycle UI locales. BusinessSite RC supports EN/DE only.
NEXT_PUBLIC_SUPPORTED_LOCALES=en,de
# Generated website content locales remain independent from the customer UI.
NEXT_PUBLIC_WEBSITE_LOCALES=de,en,fr,es,it,sq
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
NEXT_PUBLIC_SUPPORT_DISPLAY_NAME=BusinessSite RC Support
# Optional HTTPS support/help URL, or leave empty to use the support mailto link.
NEXT_PUBLIC_SUPPORT_URL=
NEXT_PUBLIC_BRAND_PRIMARY=#ff453a
NEXT_PUBLIC_BRAND_ACCENT=#ff9f0a
NEXT_PUBLIC_BRAND_BACKGROUND=#070708
NEXT_PUBLIC_BRAND_TEXT=#f5f5f7
# Optional local, versioned buyer stylesheet for visual override. Remote stylesheets
# are fail-closed until an explicit CSP/allowlist release policy exists.
NEXT_PUBLIC_BRAND_STYLESHEET_URL=
NEXT_PUBLIC_LANDING_EYEBROW=Professional websites for local businesses
NEXT_PUBLIC_LANDING_HERO_TITLE=Your business, presented at its best.
NEXT_PUBLIC_LANDING_HERO_BODY=From two basic details to a polished, responsive website. Test it, edit everything yourself and subscribe only when it feels right.
TRIAL_DURATION_DAYS=14
# Durable subscription/customer-access lifecycle. Validation rejects values
# outside the catalog bounds; changing these does not rewrite existing windows.
SUBSCRIPTION_PAYMENT_GRACE_DAYS=7
SUBSCRIPTION_READ_ONLY_DAYS=30
TRIAL_RECOVERY_DAYS=30

# German/EU launch legal identity. Never invent these values; use the operator's
# exact registered details and have the final notices reviewed professionally.
LEGAL_OPERATOR_NAME=
LEGAL_OPERATOR_LEGAL_FORM=
LEGAL_OPERATOR_REPRESENTATIVE=
LEGAL_OPERATOR_STREET=
LEGAL_OPERATOR_ADDRESS_LINE_2=
LEGAL_OPERATOR_POSTAL_CODE=
LEGAL_OPERATOR_CITY=
LEGAL_OPERATOR_COUNTRY_CODE=
LEGAL_OPERATOR_COUNTRY=
LEGAL_CONTACT_EMAIL=
LEGAL_SUPPORT_EMAIL=
LEGAL_CONTACT_PHONE=
LEGAL_REGISTER_NAME=
LEGAL_REGISTER_COURT=
LEGAL_REGISTER_NUMBER=
LEGAL_VAT_ID=
LEGAL_SUPERVISORY_AUTHORITY=
# Required when an Information/News site has journalistic-editorial content.
LEGAL_CONTENT_RESPONSIBLE=
LEGAL_DISPUTE_METADATA=
# Required commercial truth; the active reviewed DB version is authoritative in production.
# gross_inclusive | net_plus_tax | tax_exempt_or_special_note
LEGAL_TAX_DISPLAY_MODE=
LEGAL_COMMERCIAL_CURRENCY=
LEGAL_PRICE_TAX_LABEL=
# Required only for tax_exempt_or_special_note. Supply reviewed operator text.
LEGAL_SPECIAL_TAX_NOTE=
# Production must enforce customer-owned public legal identity before resolution.
CUSTOMER_PUBLIC_LEGAL_IDENTITY_REQUIRED=false

# Buyer-visible plan copy. Stripe IDs below control the actual checkout prices.
NEXT_PUBLIC_PLAN_STARTER_NAME=Starter
NEXT_PUBLIC_DEFAULT_BILLING_CURRENCY=EUR
# Public display price catalogue. Use the currency-specific variables below.
# for EUR only; use these explicit variables for new installations.
NEXT_PUBLIC_PLAN_STARTER_PRICE_EUR=€29 / month
NEXT_PUBLIC_PLAN_STARTER_PRICE_USD=$39 / month
NEXT_PUBLIC_PLAN_STARTER_PRICE_ALL=2,000 lekë / muaj
NEXT_PUBLIC_PLAN_STARTER_DESCRIPTION=Website, editor, photos, AI assistance, appointment requests, styles and an existing custom domain.
NEXT_PUBLIC_PLAN_PROFESSIONAL_NAME=Professional
NEXT_PUBLIC_PLAN_PROFESSIONAL_PRICE_EUR=€69 / month
NEXT_PUBLIC_PLAN_PROFESSIONAL_PRICE_USD=$99 / month
NEXT_PUBLIC_PLAN_PROFESSIONAL_PRICE_ALL=4,500 lekë / muaj
NEXT_PUBLIC_PLAN_PROFESSIONAL_DESCRIPTION=A future plan for capabilities beyond the complete Starter website.
NEXT_PUBLIC_PLAN_PREMIUM_NAME=Premium
NEXT_PUBLIC_PLAN_PREMIUM_PRICE_EUR=€119 / month
NEXT_PUBLIC_PLAN_PREMIUM_PRICE_USD=$139 / month
NEXT_PUBLIC_PLAN_PREMIUM_PRICE_ALL=9,900 lekë / muaj
NEXT_PUBLIC_PLAN_PREMIUM_DESCRIPTION=A future plan whose differentiated capabilities are not yet available.
# Set both variables only after the 100%-off, two-month Stripe Promotion Code
# has been created. The server automatically applies the Stripe ID at Checkout.
NEXT_PUBLIC_LAUNCH_OFFER_ENABLED=false
STRIPE_LAUNCH_PROMOTION_CODE=

# Public business-media authority. Set the exact store ID for OIDC and cleanup;
# never infer authority from the credential that happens to be available.
BLOB_STORE_ID=
# Set this only for a non-OIDC/legacy Blob connection. Its embedded store must
# match BLOB_STORE_ID.
BLOB_READ_WRITE_TOKEN=
# Separate private Vercel Blob store for Information/News editorial media.
# Required in full production when information sites are enabled.
INFORMATION_BLOB_READ_WRITE_TOKEN=
# Internal Information/News product identity. This does not expose the product
# in BusinessSite customer plans.
INFORMATION_PRODUCT_NAME=InfoEsencë
INFORMATION_PRODUCT_SLUG_EXAMPLE=infoesence

# Verified custom domains through Vercel. Token needs access only to this project.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# Optional customer-facing registrar redirect. Must be HTTPS. Direct in-app
# purchasing remains disabled until a reseller provider is configured.
DOMAIN_REGISTRAR_NAME=United Domains
DOMAIN_REGISTRAR_URL=https://www.united-domains.de/domain-suche/

# Transactional email through Resend. Verify the sender domain before production.
RESEND_API_KEY=
EMAIL_FROM=Your Platform <support@example.com>

# Enabled acquisition providers. The launch catalog currently accepts Stripe only;
# adding Paddle here fails setup/release checks and never activates it at runtime.
BILLING_PROVIDERS=stripe

# Stripe subscriptions
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PROFESSIONAL=
STRIPE_PRICE_PREMIUM=
# Additional recurring Stripe Price IDs. Leave blank until those Price IDs exist.
STRIPE_PRICE_STARTER_USD=
STRIPE_PRICE_PROFESSIONAL_USD=
STRIPE_PRICE_PREMIUM_USD=
STRIPE_PRICE_STARTER_ALL=
STRIPE_PRICE_PROFESSIONAL_ALL=
STRIPE_PRICE_PREMIUM_ALL=
# Manual acceptance that displayed Starter amounts match the configured Price IDs.
STRIPE_STARTER_PRICE_CATALOG_VERIFIED=false
# Verified Stripe Billing Portal configuration that permits payment-method and
# cancellation management but no product/plan switching.
STRIPE_PORTAL_CONFIGURATION_STARTER=
STRIPE_PORTAL_STARTER_ONLY_VERIFIED=false
# Historical only. Social Media is Coming soon and has no checkout route.
STRIPE_PRICE_SOCIAL_MEDIA_ADDON=

# Paddle acquisition and portal are runtime-disabled. This server-only switch may
# process lifecycle events only for already-bound historical subscriptions.
PADDLE_LEGACY_LIFECYCLE_ENABLED=false
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
PADDLE_PRICE_STARTER=
PADDLE_PRICE_PROFESSIONAL=
PADDLE_PRICE_PREMIUM=
PADDLE_LIVE_REVIEWED=false

# Dedicated appointment HMAC configuration. Invalid placeholders, not credentials.
# Keep old immutable versions until all live 24-hour receipts have expired.
APPOINTMENT_FINGERPRINT_KEY_VERSION=v1
APPOINTMENT_FINGERPRINT_KEYS={"v1":"replace-with-dedicated-canonical-base64url-32-byte-key"}
